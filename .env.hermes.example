# Hermes gateway — Telegram section (copy into ~/.hermes/.env, mode 600)

# Telegram Bot Token — from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the agent
TELEGRAM_ALLOWED_USERS=

# Default destination for scheduled/cron output (a chat ID)
TELEGRAM_HOME_CHANNEL=

# Display name for the home channel (untrusted metadata label only)
TELEGRAM_HOME_CHANNEL_NAME=

# Optional forum/topic thread ID for cron output
TELEGRAM_CRON_THREAD_ID=

# Long polling is the default. Webhook mode (optional):
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=
